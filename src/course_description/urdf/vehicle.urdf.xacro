<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_base" value="0.8"/>
  <xacro:property name="wheel_track" value="0.62"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="blue"><color rgba="0.05 0.36 0.72 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.28 0 0.2925"/>
      <geometry><box size="0.03 0.03 0.14"/></geometry>
      <material name="sensor_gray"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.28 0 0.2925"/>
      <geometry><box size="0.03 0.03 0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.12"/>
      <mass value="12"/>
      <inertia ixx="0.55" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>
  </link>
  <xacro:macro name="wheel" params="axle side">
    <link name="${axle}_${side}_wheel_link">
      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
        <material name="black"><color rgba="0.04 0.04 0.04 1"/></material>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
      </inertial>
    </link>
    <joint name="${axle}_${side}_wheel_fixed" type="fixed">
      <parent link="base_link"/>
      <child link="${axle}_${side}_wheel_link"/>
      <origin xyz="${wheel_base / 2 if axle == 'front' else -wheel_base / 2} ${wheel_track / 2 if side == 'left' else -wheel_track / 2} 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel axle="front" side="left"/>
  <xacro:wheel axle="front" side="right"/>
  <xacro:wheel axle="rear" side="left"/>
  <xacro:wheel axle="rear" side="right"/>
  <xacro:macro name="sensor_link" params="name size">
    <link name="${name}">
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="sensor_gray"><color rgba="0.7 0.7 0.7 1"/></material>
      </visual>
      <collision><geometry><box size="${size}"/></geometry></collision>
      <inertial>
        <mass value="0.033333333333"/>
        <inertia ixx="0.000333333333" ixy="0" ixz="0"
                 iyy="0.000333333333" iyz="0" izz="0.000333333333"/>
      </inertial>
    </link>
  </xacro:macro>
  <xacro:sensor_link name="camera_link" size="0.08 0.05 0.05"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
  <xacro:sensor_link name="lidar_link" size="0.06 0.06 0.04"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
  <xacro:sensor_link name="imu_link" size="0.04 0.04 0.03"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
</robot>
